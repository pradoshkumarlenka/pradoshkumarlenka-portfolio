{
  "name": "pradosh-portfolio",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "predev": "node scripts/copy-pdf-worker.mjs && node scripts/content.mjs",
    "dev": "next dev",
    "prebuild": "node scripts/copy-pdf-worker.mjs && node scripts/content.mjs && node scripts/cms/fallback-check.mjs",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "convert:office": "node scripts/convert-office.mjs",
    "check:content": "node scripts/content.mjs",
    "certificates": "node scripts/render-certificates.mjs",
    "test:security": "node tests/security/run-all.mjs db",
    "test:security:app": "node tests/security/run-all.mjs app",
    "test:security:all": "node tests/security/run-all.mjs all",
    "test:content": "node tests/content/fallback.mjs && node tests/content/media-route.mjs",
    "test:site": "node tests/site/features.mjs",
    "cms:backup": "node scripts/cms/backup.mjs",
    "cms:schema": "node scripts/cms/apply-schema.mjs",
    "cms:media": "node scripts/cms/apply-schema.mjs media",
    "cms:import": "node scripts/cms/import.mjs",
    "cms:verify": "node scripts/cms/verify.mjs",
    "cms:pull": "node scripts/cms/pull.mjs"
  },
  "dependencies": {
    "@gsap/react": "2.1.2",
    "@react-three/drei": "10.7.9",
    "@react-three/fiber": "9.8.2",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "@vercel/analytics": "2.0.1",
    "gsap": "3.15.0",
    "lenis": "1.3.27",
    "mammoth": "1.13.0",
    "next": "16.4.6",
    "ogl": "1.0.11",
    "pdfjs-dist": "6.4.299",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "recharts": "3.10.1",
    "server-only": "0.0.1",
    "three": "0.186.1",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "^22",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/three": "0.186.0",
    "ajv": "^8.20.0",
    "eslint": "^9",
    "eslint-config-next": "16.4.6",
    "pg": "8.23.1",
    "puppeteer-core": "24.43.1",
    "tailwindcss": "4.3.3",
    "ts-json-schema-generator": "^2.9.0",
    "typescript": "5.9.3"
  }
}

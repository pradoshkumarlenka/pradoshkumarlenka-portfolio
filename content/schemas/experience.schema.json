{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string",
      "description": "Editor helper that powers hints and error checking. Leave it as it is."
    },
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "company": {
            "type": "string"
          },
          "title": {
            "type": "string"
          },
          "summary": {
            "type": "string",
            "description": "One-sentence description shown under the role."
          },
          "marker": {
            "type": "string",
            "enum": [
              "current",
              "past"
            ],
            "description": "\"current\" = filled marker (latest role); \"past\" = outlined marker."
          },
          "location": {
            "type": "string"
          },
          "start": {
            "type": "string"
          },
          "end": {
            "type": "string"
          },
          "outcome": {
            "type": "string"
          },
          "bullets": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "tags": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "note": {
            "type": "string"
          }
        },
        "required": [
          "company",
          "title",
          "summary",
          "marker",
          "location",
          "start",
          "end",
          "outcome",
          "bullets",
          "tags"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "description": "content/experience.json — the work timeline.",
  "definitions": {}
}
